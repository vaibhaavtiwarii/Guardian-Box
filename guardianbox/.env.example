PORT=3001
S3_BUCKET=guardianbox-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Largest file a user may share, in MB. Files are encrypted and uploaded in 4 MB chunks,
# so the server never holds more than one chunk in memory.
MAX_UPLOAD_MB=500
# Set true to forbid silent fallback to local disk (use for real S3 / proof)
S3_STRICT=false
# Comma-separated allowed origins in production, e.g. https://guardianbox.example.com
CORS_ORIGIN=
RATE_LIMIT_PER_MIN=120
# Chunk transfers are many small requests, so they get their own, higher limit
CHUNK_RATE_LIMIT_PER_MIN=1500
# Signs download tokens. Leave empty to use a random secret per start-up.
DOWNLOAD_TOKEN_SECRET=

# --- Production / hosted setup (Render + Turso + Tigris) ---
# Hosted metadata DB (leave empty locally to use a SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Hosted S3 providers (e.g. Tigris) use virtual-hosted style: set false there.
S3_FORCE_PATH_STYLE=true
# Set to 1 when running behind a reverse proxy (Render, etc.)
TRUST_PROXY=
